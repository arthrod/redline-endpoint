apiVersion: v1
kind: Secret
metadata:
  name: rapidapi-secrets
  namespace: redline-api
type: Opaque
stringData:
  # RapidAPI Proxy Secret - validates requests come from RapidAPI infrastructure
  # Get this value from your RapidAPI Provider Dashboard -> Security tab
  proxy-secret: "YOUR_RAPIDAPI_PROXY_SECRET_HERE"
---
apiVersion: v1
kind: Secret
metadata:
  name: ghcr-secret
  namespace: redline-api
type: kubernetes.io/dockerconfigjson
data:
  # Generate this with:
  # kubectl create secret docker-registry ghcr-secret \
  #   --docker-server=ghcr.io \
  #   --docker-username=YOUR_GITHUB_USERNAME \
  #   --docker-password=YOUR_GITHUB_PAT \
  #   --namespace=redline-api \
  #   --dry-run=client -o yaml
  .dockerconfigjson: YOUR_BASE64_ENCODED_DOCKER_CONFIG
